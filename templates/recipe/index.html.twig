{% extends 'base.html.twig' %}

{% block title %}Cookbook{% endblock %}

{% block body %}
<main class="container py-4">
    <h1 class="mb-4">Cookbook</h1>

    <div id="flash-messages">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
    </div>

    <section class="card mb-5">
        <div class="card-body">
            <h2 class="h4 mb-3">Add a recipe</h2>
            {{ include('recipe/_form.html.twig') }}
        </div>
    </section>

    <section>
        <h2 class="h4 mb-3">Recipes</h2>

        {% if recipes is empty %}
            <p id="recipe-list-empty" class="text-muted">No recipes yet. Add your first one above!</p>
        {% endif %}

        <div id="recipe-list" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            {% for recipe in recipes %}
                {{ include('recipe/_card.html.twig') }}
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
