<div id="recipe-form">
    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.preparationTime) }}
        {{ form_row(form.image) }}

        <fieldset class="mb-3"
            data-controller="form-collection"
            data-form-collection-index-value="{{ form.ingredients|length > 0 ? form.ingredients|last.vars.name + 1 : 0 }}"
            data-form-collection-prototype-value="{{ include('recipe/_ingredient_row.html.twig', {ingredient: form.ingredients.vars.prototype})|e('html_attr') }}"
        >
            <legend class="h6">Ingredients</legend>
            {{ form_errors(form.ingredients) }}

            <div data-form-collection-target="collectionContainer">
                {% for ingredient in form.ingredients %}
                    {{ include('recipe/_ingredient_row.html.twig') }}
                {% endfor %}
            </div>
            {% do form.ingredients.setRendered %}

            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="form-collection#add">
                + Add ingredient
            </button>
        </fieldset>

        {{ form_row(form.instructions) }}

        <button type="submit" class="btn btn-primary">Save recipe</button>
    {{ form_end(form) }}
</div>
