<div id="recipe-form">
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        <div class="form-stack">
            {% if form.vars.submitted and not form.vars.valid %}
                <div class="alert alert-danger form-alert" role="alert">
                    Please fill in the required fields before saving your recipe.
                </div>
                {{ form_errors(form) }}
            {% endif %}

            <div class="row g-3">
                <div class="col-12">
                    {{ form_row(form.title) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.preparationTime) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.image) }}
                </div>
            </div>

            <fieldset class="ingredient-builder"
                data-controller="form-collection"
                data-form-collection-index-value="{{ form.ingredients|length > 0 ? form.ingredients|last.vars.name + 1 : 0 }}"
                data-form-collection-prototype-value="{{ include('recipe/_ingredient_row.html.twig', {ingredient: form.ingredients.vars.prototype})|e('html_attr') }}"
            >
                <legend class="h6 mb-0">Ingredients</legend>
                <div class="ingredient-builder__header">
                    <div>
                        <p>Add each ingredient with amount and unit so the scaling tool stays useful.</p>
                    </div>

                    <button type="button" class="btn btn-outline-secondary app-button app-button--ghost" data-action="form-collection#add">
                        + Add ingredient
                    </button>
                </div>

                {{ form_errors(form.ingredients) }}

                <div class="ingredient-builder__list" data-form-collection-target="collectionContainer">
                    {% for ingredient in form.ingredients %}
                        {{ include('recipe/_ingredient_row.html.twig') }}
                    {% endfor %}
                </div>
                {% do form.ingredients.setRendered %}
            </fieldset>

            {{ form_row(form.instructions) }}

            <button type="submit" class="btn btn-primary app-button app-button--primary w-100">
                Save recipe
            </button>
        </div>
    {{ form_end(form) }}
</div>
