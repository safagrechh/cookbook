{% extends 'base.html.twig' %}

{% block title %}{{ recipe.title }} – Cookbook{% endblock %}

{% block body %}
<main class="container py-4" style="max-width: 800px;">
    <a href="{{ path('app_home') }}" class="btn btn-link px-0 mb-3">← Back to all recipes</a>

    <h1 class="text-break">{{ recipe.title }}</h1>
    <p class="text-muted">⏱ Preparation time: {{ recipe.preparationTime }} min</p>

       <section class="mb-4" data-controller="scale">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h2 class="h4 mb-0">Ingredients</h2>

            <div class="d-flex align-items-center gap-2">
                <label for="scale-factor" class="form-label mb-0">Multiply by</label>
                <input type="number" id="scale-factor"
                       class="form-control" style="width: 6rem;"
                       value="1" min="0.1" step="any"
                       data-scale-target="factor"
                       data-action="input->scale#update">
            </div>
        </div>

        <ul class="list-group">
            {% for ingredient in recipe.ingredients %}
                <li class="list-group-item">
                    <span class="fw-semibold">
                        <span data-scale-target="amount" data-base-amount="{{ ingredient.amount }}">{{ ingredient.amount }}</span>
                        {{ ingredient.unit.label }}
                    </span>
                    {{ ingredient.name }}
                </li>
            {% endfor %}
        </ul>
    </section>
     {# Imageeeeeeeee #}
    {% if recipe.imageFilename %}
        <img src="{{ asset('uploads/recipes/' ~ recipe.imageFilename) }}"
             class="img-fluid rounded mb-4 w-100" style="max-height: 400px; object-fit: cover;"
             alt="{{ recipe.title }}">
    {% endif %}
    <section>
        <h2 class="h4">Instructions</h2>
        <p>{{ recipe.instructions|nl2br }}</p>
    </section>
</main>
{% endblock %}
