<div class="col">
    <article class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h3 class="card-title h5 text-break">{{ recipe.title }}</h3>
            <p class="card-text text-muted">⏱ {{ recipe.preparationTime }} min</p>
            <a href="{{ path('app_recipe_show', {id: recipe.id}) }}"
               class="btn btn-outline-primary mt-auto stretched-link">
                View recipe
            </a>
        </div>
    </article>

    <div class="col">
    <article class="card h-100 shadow-sm">
        {% if recipe.imageFilename %}
            <img src="{{ asset('uploads/recipes/' ~ recipe.imageFilename) }}"
                 class="card-img-top recipe-card-img" alt="{{ recipe.title }}">
        {% else %}
            <div class="card-img-top recipe-card-img bg-light d-flex align-items-center justify-content-center fs-1">
                🍽️
            </div>
        {% endif %}
    </article>
</div>

</div>
