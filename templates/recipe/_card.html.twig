<div class="col">
    <article class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h3 class="card-title h5 text-break">{{ recipe.title }}</h3>
            <p class="card-text text-muted">⏱ {{ recipe.preparationTime }} min</p>
            <a href="{{ path('app_recipe_show', {id: recipe.id}) }}"
               class="btn btn-outline-primary mt-auto stretched-link">
                View recipe
            </a>
        </div>
    </article>
</div>
