<div class="col">
    <article class="recipe-card card h-100 border-0">
        <div class="recipe-card__media">
            <span class="recipe-card__time">{{ recipe.preparationTime }} min</span>
        {% if recipe.imageFilename %}
            <img src="{{ asset('uploads/recipes/' ~ recipe.imageFilename) }}"
                 class="recipe-card-img" alt="{{ recipe.title }}">
        {% else %}
            <div class="recipe-card-img recipe-card-img--placeholder">
                {{ recipe.title|slice(0, 1)|upper }}
            </div>
        {% endif %}
        </div>

        <div class="card-body recipe-card__body">
            <div class="recipe-card__meta">
                <span>{{ recipe.ingredients|length }} ingredient{% if recipe.ingredients|length != 1 %}s{% endif %}</span>
                <span>Ready to cook</span>
            </div>

            <h3 class="card-title h5 text-break mb-2">{{ recipe.title }}</h3>

            <p class="recipe-card__excerpt">
                {{ recipe.instructions|striptags|slice(0, 120) }}{% if recipe.instructions|length > 120 %}…{% endif %}
            </p>

            <div class="recipe-card__footer">
                <span>Open recipe</span>
                <span aria-hidden="true">→</span>
            </div>

            <a href="{{ path('app_recipe_show', {id: recipe.id}) }}"
               class="stretched-link"
               aria-label="Open {{ recipe.title }}"></a>
        </div>
    </article>
</div>
